      "appSecret": "{{FEISHU_APP_SECRET}}",
      "chats": {{FEISHU_CHATS}},
      "limit": 50
    },
    "wecom": {
      "enabled": false
    }
  },
  "extractor": {
    "keywords": {{EXTRACTOR_KEYWORDS}}
  }
